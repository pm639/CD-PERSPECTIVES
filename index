<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<title>CD Atelier</title>
<template id="__bundler_thumbnail"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="#550000"/><text x="50" y="60" text-anchor="middle" font-family="Helvetica Neue,Arial" font-size="28" fill="#f3eee2" letter-spacing="-1">CD</text></svg></template>
<style>
html{scroll-behavior:smooth}
body{margin:0;background:#f3eee2;color:#1d1714;font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent,#550000)}
::selection{background:#550000;color:#f3eee2}
</style>
</helmet>


<section id="top" data-screen-label="Hero" style="position:relative;background:var(--accent,#550000);color:#f3eee2;padding:clamp(28px,5vw,64px) clamp(20px,4vw,56px) clamp(24px,4vw,48px);min-height:100vh;min-height:100svh;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;gap:40px;overflow:hidden">
  <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:11px;letter-spacing:.42em;text-transform:uppercase">
    <span>New York</span>
    <span>Art · Design · Direction</span>
  </div>
  <sc-if value="{{ showPortrait }}" hint-placeholder-val="{{ true }}">
    <div data-reveal="" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-54%);width:clamp(200px,26vw,380px);aspect-ratio:368/445;box-shadow:0 30px 80px rgba(0,0,0,.35)">
      <img src="assets/masked-portrait.jpg" alt="Masked portrait, oil on canvas" style="width:100%;height:100%;object-fit:cover;display:block;filter:contrast(1.05) saturate(.9)" />
    </div>
  </sc-if>
  <div style="position:relative;z-index:1;display:flex;flex-direction:column;gap:18px">
    <h1 style="margin:0;font-weight:500;font-size:clamp(72px,16.5vw,300px);line-height:.82;letter-spacing:-.045em;white-space:nowrap">CD Atelier</h1>
    <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:11px;letter-spacing:.42em;text-transform:uppercase;border-top:1px solid rgba(243,238,226,.35);padding-top:16px">
      <span>Art Advisory</span><span>Creative Direction</span><span>Sourcing</span><span>Collectible Design</span>
    </div>
  </div>
</section>

<section id="services" data-screen-label="Services" style="padding:clamp(64px,10vw,140px) clamp(20px,4vw,56px);display:flex;flex-wrap:wrap;gap:clamp(32px,6vw,96px);align-items:flex-start">
  <div style="flex:1 1 520px;min-width:0">
    <div style="font-size:11px;letter-spacing:.42em;text-transform:uppercase;margin-bottom:40px">Services</div>
    <div style="border-top:1px solid rgba(29,23,20,.2)">
      <sc-for list="{{ services }}" as="s" hint-placeholder-count="4">
        <div onMouseEnter="{{ s.onEnter }}" onClick="{{ s.onEnter }}" data-reveal="" style="display:grid;grid-template-columns:56px minmax(0,1fr);align-items:baseline;gap:12px;padding:clamp(18px,2.4vw,30px) 0;border-bottom:1px solid rgba(29,23,20,.2);cursor:default;transition:color .3s" style-hover="color:var(--accent,#550000)">
          <span style="font-size:11px;letter-spacing:.3em;font-variant-numeric:tabular-nums">{{ s.num }}</span>
          <span style="font-size:clamp(34px,5.4vw,84px);font-weight:400;letter-spacing:-.03em;line-height:1">{{ s.name }}</span>
        </div>
      </sc-for>
    </div>
  </div>
  <figure style="flex:0 1 380px;min-width:240px;margin:0;position:sticky;top:120px;display:flex;flex-direction:column;gap:14px">
    <div style="position:relative;aspect-ratio:4/5;background:#e6dfcf;overflow:hidden">
      <img src="assets/grey-painting.jpg" alt="Art Advisory" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .5s;opacity:{{ op0 }}" />
      <img src="assets/rider.png" alt="Creative Direction" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .5s;opacity:{{ op1 }}" />
      <img src="assets/pottery-archive.png" alt="Sourcing" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .5s;opacity:{{ op2 }}" />
      <img src="assets/chrome-chair.jpg" alt="Collectible Design" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .5s;opacity:{{ op3 }}" />
    </div>
    <figcaption style="display:flex;justify-content:space-between;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:rgba(29,23,20,.7)"><span>{{ svcNum }}</span><span>{{ svcName }}</span></figcaption>
  </figure>
</section>

<section id="about" data-screen-label="About" style="padding:clamp(64px,10vw,140px) clamp(20px,4vw,56px);border-top:1px solid rgba(29,23,20,.14);display:flex;flex-wrap:wrap;gap:clamp(24px,5vw,72px)">
  <div style="flex:1 1 240px;display:flex;flex-direction:column;justify-content:space-between;gap:32px">
    <div style="font-size:11px;letter-spacing:.42em;text-transform:uppercase">About</div>
    <img src="assets/cd-monogram.png" alt="CD monogram, blind embossed" style="width:min(220px,60%);aspect-ratio:1;object-fit:cover;display:block" />
  </div>
  <p data-reveal="" style="flex:2 1 420px;min-width:0;margin:0;font-size:clamp(20px,2.3vw,34px);line-height:1.32;letter-spacing:.04em;text-transform:uppercase;font-weight:400;text-wrap:pretty;max-width:30em">CD Atelier is a New York–based creative studio spanning art advisory, collectible design, sourcing, and creative direction. Every project is grounded in market research and curatorial strategy, bringing art market expertise and a strong design sensibility to work that is personal, culturally relevant, and visually distinctive</p>
</section>

<section data-screen-label="References" style="padding:0 clamp(20px,4vw,56px) clamp(64px,10vw,140px);display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(8px,1.2vw,18px);align-items:end">
  <div data-reveal="" style="grid-column:span 5;aspect-ratio:1;overflow:hidden"><img src="assets/sleeping-head.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
  <div data-reveal="" style="grid-column:span 3;aspect-ratio:345/445;overflow:hidden"><img src="assets/red-chair.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
  <div data-reveal="" style="grid-column:span 4;aspect-ratio:417/491;overflow:hidden"><img src="assets/black-vessel.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
  <div data-reveal="" style="grid-column:span 3;aspect-ratio:417/546;overflow:hidden"><img src="assets/textile.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
  <div data-reveal="" style="grid-column:span 5;aspect-ratio:603/371;overflow:hidden"><img src="assets/curtain.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
  <div data-reveal="" style="grid-column:span 4;aspect-ratio:455/405;overflow:hidden"><img src="assets/corten-bar.jpg" alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
</section>

<section id="framework" data-screen-label="Framework" style="background:#2e2320;color:#f3eee2;padding:clamp(80px,14vw,200px) clamp(20px,4vw,56px);display:flex;flex-direction:column;gap:48px">
  <div style="font-size:11px;letter-spacing:.42em;text-transform:uppercase">Framework</div>
  <p data-reveal="" style="margin:0;font-size:clamp(34px,6vw,96px);line-height:1.02;letter-spacing:-.03em;font-weight:400;max-width:14em;text-wrap:balance">my framework as a creative director is rooted in a synthesis of <span style="font-style:italic;font-family:'Times New Roman',Times,serif;letter-spacing:-.01em">history, culture, and lived experience</span></p>
  <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:11px;letter-spacing:.42em;text-transform:uppercase;border-top:1px solid rgba(243,238,226,.25);padding-top:16px">
    <span>Carolina Doria</span><span>Founder, CD Atelier</span>
  </div>
</section>

<section id="contact" data-screen-label="Contact" style="padding:clamp(64px,10vw,140px) clamp(20px,4vw,56px) 40px;display:flex;flex-direction:column;gap:clamp(56px,9vw,120px)">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:32px;align-items:end">
    <div style="display:flex;flex-direction:column;gap:20px;grid-column:span 2">
      <div style="font-size:11px;letter-spacing:.42em;text-transform:uppercase">Contact</div>
      <a href="mailto:studio@cdatelier.com" style="font-size:clamp(30px,5vw,76px);letter-spacing:-.03em;line-height:1;border-bottom:1px solid currentColor;padding-bottom:8px;align-self:flex-start;transition:color .3s">studio@cdatelier.com</a>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;font-size:11px;letter-spacing:.42em;text-transform:uppercase;line-height:1.8">
      <span>New York</span>
      <span>By appointment</span>
    </div>
  </div>
  <footer style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;border-top:1px solid rgba(29,23,20,.2);padding-top:18px;font-size:9px;letter-spacing:.3em;text-transform:uppercase;line-height:1.8;color:rgba(29,23,20,.72)">
    <span style="max-width:70em">© Carolina Doria 2025. Any reproduction, disclosure, or distribution of this material without express authorization is strictly prohibited.</span>
    <span>CD Atelier</span>
  </footer>
</section>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;accent&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#550000&quot;,&quot;options&quot;:[&quot;#550000&quot;,&quot;#2e2320&quot;,&quot;#6f5a34&quot;],&quot;tsType&quot;:&quot;string&quot;},&quot;hero&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;default&quot;:&quot;portrait&quot;,&quot;options&quot;:[&quot;portrait&quot;,&quot;type only&quot;],&quot;tsType&quot;:&quot;string&quot;},&quot;reveal&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;}}">
class Component extends DCLogic {
  state = { svc: 0 };
  static SERVICES = [
    { name: 'Art Advisory', img: 'assets/grey-painting.jpg' },
    { name: 'Creative Direction', img: 'assets/rider.png' },
    { name: 'Sourcing', img: 'assets/pottery-archive.png' },
    { name: 'Collectible Design', img: 'assets/chrome-chair.jpg' },
  ];
  applyAccent() {
    document.documentElement.style.setProperty('--accent', this.props.accent ?? '#550000');
  }
  componentDidMount() {
    this.applyAccent();
    if ((this.props.reveal ?? true) === false || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        e.target.animate(
          [{ opacity: 0, transform: (e.target.style.transform || '') + ' translateY(24px)' }, { opacity: 1, transform: e.target.style.transform || 'none' }],
          { duration: 900, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'both' }
        );
      });
    }, { threshold: 0.12 });
    this._io = io;
    setTimeout(() => document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el)), 50);
  }
  componentDidUpdate() { this.applyAccent(); }
  componentWillUnmount() { this._io && this._io.disconnect(); }
  renderVals() {
    const S = Component.SERVICES;
    const cur = S[this.state.svc];
    return {
      showPortrait: (this.props.hero ?? 'portrait') === 'portrait',
      services: S.map((s, i) => ({ ...s, num: String(i + 1).padStart(2, '0'), onEnter: () => this.setState({ svc: i }) })),
      op0: this.state.svc === 0 ? 1 : 0,
      op1: this.state.svc === 1 ? 1 : 0,
      op2: this.state.svc === 2 ? 1 : 0,
      op3: this.state.svc === 3 ? 1 : 0,
      svcName: cur.name,
      svcNum: String(this.state.svc + 1).padStart(2, '0'),
    };
  }
}
</script>
</body>
</html>
